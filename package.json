{
  "name": "gh-polish",
  "version": "0.0.0",
  "description": "Agent-driven GitHub repository polish workflow.",
  "type": "module",
  "private": true,
  "bin": {
    "gh-polish": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
